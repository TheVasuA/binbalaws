# Copy this file to .env and fill in your real values. Never commit .env.

# ── Binance API ──────────────────────────────────────────────────────────────
# Create a key at https://www.binance.com/en/my/settings/api-management
# Enable "Enable Futures" permission. Do NOT enable withdrawals.
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret
BINANCE_TESTNET=false
NEXT_PUBLIC_BINANCE_TESTNET=false

# ── Redis (Upstash) — used for settings + the shared API cache ────────────────
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
DOMAIN=your-domain.com
